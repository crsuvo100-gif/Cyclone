# CYCLONE TERMINAL AI V10 — Local Environment

# ── Model backend (Ollama / local) ─────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
MODEL=nemotron-3-super-120b-a12b:free

# ── MOON backend server ─────────────────────────────────────────
MOON_PORT=8777

# ── HerMes ACP (VS Code / editor integration) ───────────────────
HERMES_PROVIDER=openrouter
HERMES_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Voice (optional) ────────────────────────────────────────────
VOICE_PRESET=seductive

# ── Optional remote AI (local mode works without these) ─────────
# CYCLONE_AI_API_KEY=sk-...
# CYCLONE_AI_BASE_URL=https://api.openai.com/v1
# CYCLONE_AI_MODEL=gpt-4o-mini

# ── Optional: persistent cloud memory (if configured) ───────────
CYCLONE_DATA_DIR=~/.cyclone-terminal-ai/state-v10.json
